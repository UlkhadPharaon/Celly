{
  "name": "celly",
  "version": "0.2.1",
  "private": true,
  "description": "Celly v0.2 — a touch-free 3D cell biology laboratory, knowledge network and quiz, controlled by your bare hands",
  "license": "MIT",
  "author": "Ulkhad Pharaon",
  "homepage": "https://celly-blue.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UlkhadPharaon/Celly.git"
  },
  "bugs": {
    "url": "https://github.com/UlkhadPharaon/Celly/issues"
  },
  "keywords": [
    "webxr",
    "hand-tracking",
    "mediapipe",
    "threejs",
    "webgl",
    "cell-biology",
    "education"
  ],
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "prebuild": "node scripts/fetch-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"*.{md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.5",
    "@mediapipe/tasks-vision": "1.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.22.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
